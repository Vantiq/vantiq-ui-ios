CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER = NO
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) COCOAPODS=1
GENERATE_INFOPLIST_FILE = YES
HEADER_SEARCH_PATHS = $(inherited) "${PODS_ROOT}/Headers/Public" "${PODS_ROOT}/Headers/Public/AppAuth" "${PODS_ROOT}/Headers/Public/Base64" "${PODS_ROOT}/Headers/Public/JWT" "${PODS_ROOT}/Headers/Public/vantiq-sdk-ios" "${PODS_ROOT}/Headers/Public/vantiq-ui-ios"
LIBRARY_SEARCH_PATHS = $(inherited) "${PODS_CONFIGURATION_BUILD_DIR}/AppAuth" "${PODS_CONFIGURATION_BUILD_DIR}/Base64" "${PODS_CONFIGURATION_BUILD_DIR}/JWT" "${PODS_CONFIGURATION_BUILD_DIR}/vantiq-sdk-ios" "${PODS_CONFIGURATION_BUILD_DIR}/vantiq-ui-ios"
OTHER_CFLAGS = $(inherited) -fmodule-map-file="${PODS_ROOT}/Headers/Public/AppAuth/AppAuth.modulemap"
OTHER_LDFLAGS = $(inherited) -ObjC -l"AppAuth" -l"Base64" -l"JWT" -l"vantiq-sdk-ios" -l"vantiq-ui-ios" -framework "SafariServices" -framework "Security" -weak_framework "AuthenticationServices"
OTHER_MODULE_VERIFIER_FLAGS = $(inherited) "-F${PODS_CONFIGURATION_BUILD_DIR}/AppAuth" "-F${PODS_CONFIGURATION_BUILD_DIR}/Base64" "-F${PODS_CONFIGURATION_BUILD_DIR}/JWT" "-F${PODS_CONFIGURATION_BUILD_DIR}/vantiq-sdk-ios" "-F${PODS_CONFIGURATION_BUILD_DIR}/vantiq-ui-ios"
OTHER_SWIFT_FLAGS = $(inherited) -D COCOAPODS -Xcc -fmodule-map-file="${PODS_ROOT}/Headers/Public/AppAuth/AppAuth.modulemap"
PODS_BUILD_DIR = ${BUILD_DIR}
PODS_CONFIGURATION_BUILD_DIR = ${PODS_BUILD_DIR}/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)
PODS_PODFILE_DIR_PATH = ${SRCROOT}/.
PODS_ROOT = ${SRCROOT}/Pods
PODS_XCFRAMEWORKS_BUILD_DIR = $(PODS_CONFIGURATION_BUILD_DIR)/XCFrameworkIntermediates
USE_RECURSIVE_SCRIPT_INPUTS_IN_SCRIPT_PHASES = YES
